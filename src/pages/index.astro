---
/* ツールハブ（React なし）
   いま使えるツールを最初に見せる / 準備中はたたんでおく / 学ぶ導線。動きは src/scripts/hub.js */
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Corp from "../components/Corp.astro";
import Icon from "../components/Icon.astro";
import SectionHead from "../components/SectionHead.astro";
import Faq from "../components/Faq.astro";
import HUB from "../data/hub.js";
import { ORG, PUBLISHER } from "../data/org.js";
import "../styles/hub.css";

/* 並び順は hub.js の hot（こちらで決めたおすすめ順）。利用回数を数えられるようになったら uses 順も検討する */
const live = HUB.TOOLS.filter((t) => t.status === "live").sort((a, b) => (a.hot ?? 99) - (b.hot ?? 99));
const soon = HUB.TOOLS.filter((t) => t.status === "soon");
const urlTools = live.filter((t) => t.url);
const catLabel = (id: string) => HUB.CATS.find((c) => c.id === id)?.label ?? "";
const soonCats = HUB.CATS.filter((c) => soon.some((t) => t.cat === c.id));
/* 検索で拾うことば（全角・半角をそろえて小文字に。hub.js も同じようにそろえて比べる） */
const searchKey = (t: (typeof HUB.TOOLS)[number]) => [t.name, t.desc, t.slug, catLabel(t.cat), t.kw ?? ""].join(" ").normalize("NFKC").toLowerCase();

const site = "https://tools.insemble.jp/";
const jsonLd = [
  ORG,
  { "@context": "https://schema.org", "@type": "WebSite", name: "insemble tools", url: site, inLanguage: "ja", publisher: PUBLISHER },
  { "@context": "https://schema.org", "@type": "ItemList", name: "無料で使える便利ツール", itemListElement: live.map((t, i) => ({ "@type": "ListItem", position: i + 1, name: t.name, url: site + t.slug + "/" })) },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: HUB.FAQ.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];

const NAV: [string, string][] = [["#tools", "ツール"], ["#learn", "学ぶ"], ...(HUB.SHOW_UPDATES ? [["#updates", "更新情報"] as [string, string]] : []), ["#faq", "よくある質問"]];
const FOOT: { h: string; items: [string, string][] }[] = [
  { h: "ツール", items: [...live.map((t) => [HUB.label(t), "/" + t.slug + "/"] as [string, string]), ["ツール一覧", "#tools"]] },
  { h: "学ぶ", items: [["OGPタグ辞典", "/ogp/#glossary"], ...(HUB.SHOW_UPDATES ? [["更新情報", "#updates"] as [string, string]] : [])] },
  { h: "サポート", items: [["よくある質問", "#faq"]] },
];
---
<Base
  title="仕事とWeb制作の無料ツール集｜締切・PDF・席順・Excel・OGP｜insemble tools"
  description="PDFの文字や画像を取り出す、席順やグループを決める、予定表をExcelにする、締切までの残り時間を数える、OGPをチェックする。毎回ちょっと面倒な作業を片づける無料ツール集です。登録不要・広告なしで、ブラウザだけで使えます。"
  path="/"
  jsonLd={jsonLd}
>
  <Header nav={NAV} />

  <main>
    <!-- ===== ヒーロー（短く。すぐ下にツールを見せる） ===== -->
    <section class="hub-hero">
      <div class="hero-glow"></div>
      <div class="hero-deco far" aria-hidden="true">
        <i style="width:9px;height:9px;left:13%;top:34%;background:var(--primary);opacity:.45"></i>
        <i style="width:13px;height:13px;left:80%;top:56%;border:2px solid var(--primary);opacity:.3"></i>
        <i style="width:5px;height:5px;left:52%;top:14%;background:oklch(0.66 0.10 162);opacity:.5"></i>
      </div>
      <div class="hero-deco near" aria-hidden="true">
        <i style="width:7px;height:7px;left:86%;top:26%;background:oklch(0.62 0.09 235);opacity:.4"></i>
        <i style="width:8px;height:8px;left:20%;top:64%;border:2px solid oklch(0.62 0.10 162);opacity:.35"></i>
      </div>
      <div class="wrap hub-hero-in">
        <h1 class="hub-h1"><Icon name="sparkle" size={14} />無料で使える 仕事とWeb制作の便利ツール集</h1>
        <p class="hub-title">毎回ちょっと<span class="hl">面倒</span>を、<br class="sp-br" />ここで片づける。</p>
        <p class="hub-sub">登録も広告もなく、ブラウザを開けばすぐに使えます。</p>

        <!-- ツールを探す専用。入れたそばから下の一覧を絞り込む（URLを貼ったときは、OGPチェッカーへのリンクを出すだけで、勝手には動かさない） -->
        <form class="hub-search" id="hub-search" role="search" data-clarity-mask="True">
          <Icon name="search" size={19} style="color:var(--muted)" />
          <input type="search" enterkeyhint="search" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="ツール名・やりたいこと（例：PDF、席順、締切）" aria-label="ツールを探す" aria-controls="live-list" />
          <button type="button" class="hub-clear" id="hub-clear" aria-label="入力を消す" hidden><Icon name="x" size={14} /></button>
        </form>
        {urlTools[0] && (
          <p class="hub-meta" id="hub-url" hidden data-clarity-mask="True">
            <a class="hub-meta-url" id="hub-url-link" href={"/" + urlTools[0].slug + "/"} data-open={urlTools[0].slug}>このURLを{urlTools[0].name}で確認する<Icon name="arrow" size={14} /></a>
          </p>
        )}
      </div>
    </section>

    <div class="wrap" id="tools" style="scroll-margin-top:72px">
      <!-- お気に入り／最近使った は JS で出す -->
      <div id="my-slot"></div>

      <!-- ===== いま使えるツール（ここが主役） ===== -->
      <section class="feat" aria-labelledby="live-h">
        <div class="feat-head">
          <h2 class="feat-k" id="live-h">いま使えるツール</h2>
          <span class="feat-n" id="live-n">{live.length}</span>
          <span class="feat-note">☆でお気に入りに追加できます</span>
        </div>
        <div class="feat-rows" id="live-list">
          {live.map((t) => (
            <div class="f-row" data-search={searchKey(t)}>
              <a class="f-link" href={"/" + t.slug + "/"} data-open={t.slug}>
                <span class="f-top">
                  <span class="f-ic"><Icon name={t.icon} size={22} tool /></span>
                  <span class="f-date f-cat">{catLabel(t.cat)}</span>
                </span>
                <span class="f-name">{t.name}{t.isNew && <span class="lbl new">NEW</span>}</span>
                <span class="f-desc">{t.desc}</span>
                <span class="f-go">使ってみる<Icon name="arrow" size={15} /></span>
              </a>
              <button type="button" class="fav" data-fav={t.slug} aria-pressed="false" aria-label={`${t.name}をお気に入りに追加`}><Icon name="star" size={17} tool /></button>
            </div>
          ))}
        </div>
        <div class="no-hit" id="no-hit" hidden>
          <p class="no-hit-t">「<span id="no-hit-q"></span>」に合うツールが見つかりませんでした</p>
          <p class="no-hit-d">「PDF」「席順」「締切」のように、短いことばにすると見つかりやすくなります。</p>
          <div class="no-hit-a"><button type="button" class="btn btn-ghost" id="no-hit-clear">すべてのツールを表示</button></div>
        </div>
      </section>
    </div>

    <!-- ===== これから公開するツール（ふだんはたたんでおく。点線アイコン＋灰色、リンクしない） ===== -->
    <section class="band" id="catalog" style="scroll-margin-top:64px">
      <div class="wrap sec sec-tight">
        <details class="soon-box" id="soon-box">
          <!-- 見出し（h2）と件数は分けておく（件数が見出しの文字に混ざらないように）。並べ方は hub.css の .soon-box>summary -->
          <summary>
            <h2 class="soon-t">これから公開するツール</h2>
            <span class="feat-n soon-n" id="soon-n">{soon.length}</span>
            <span class="soon-d">準備ができたものから、順に公開します。</span>
            <Icon name="chevron" size={18} class="soon-chev" />
          </summary>
          {soonCats.map((c) => {
            const items = soon.filter((t) => t.cat === c.id);
            return (
              <section class="cat" data-cat-sec={c.id}>
                <div class="cat-head">
                  <h3 class="cat-t">{c.label}</h3>
                  <span class="cat-note">{c.note}</span>
                  <span class="cat-n">{items.length}</span>
                </div>
                <div class="t-grid">
                  {items.map((t) => (
                    <div class="t-row soon" data-search={searchKey(t)}>
                      <a class="t-link" aria-disabled="true">
                        <span class="t-ic"><Icon name={t.icon} size={19} tool /></span>
                        <span class="t-body">
                          <span class="t-name">{t.name}<span class="lbl">準備中</span></span>
                          <span class="t-desc">{t.desc}</span>
                        </span>
                      </a>
                    </div>
                  ))}
                </div>
              </section>
            );
          })}
        </details>
      </div>
    </section>

    <!-- ===== 学ぶ ===== -->
    <section class="wrap sec">
      <SectionHead id="learn" kicker="学ぶ" title="使いながら、分かる" sub="用語の意味や設定のコツを、ツールと行き来しながら読めるようにまとめています。" />
      <div class="learn">
        {HUB.LEARN.map((l) => {
          const inner = (
            <>
              <span class="l-kind">{l.kind}</span>
              <span class="l-main">
                <span class="l-title">{l.title}{l.soon ? <span class="lbl">準備中</span> : <Icon name="arrow" size={15} />}</span>
                <span class="l-desc">{l.desc}</span>
              </span>
            </>
          );
          return l.soon
            ? <div class="l-row soon reveal" aria-disabled="true">{inner}</div>
            : <a class="l-row reveal" href={l.href}>{inner}</a>;
        })}
      </div>
    </section>

    {HUB.SHOW_UPDATES && (
      <section class="wrap sec sec-tight">
        <SectionHead id="updates" kicker="更新情報" title="いつ、何が変わったか" sub="新しいツールの公開や改善を、日付つきで記録しています。" />
        <div class="log">
          {HUB.CHANGELOG.map((u) => {
            const t = HUB.TOOLS.find((x) => x.slug === u.tool);
            return (
              <div class="log-row reveal">
                <time class="log-date">{u.date}</time>
                <span class={"log-kind k-" + (u.kind === "新規" ? "new" : u.kind === "改善" ? "up" : "fix")}>{u.kind}</span>
                <span class="log-text">{u.text}</span>
                {t && <a class="log-tool" href={"/" + t.slug + "/"}>{t.name}</a>}
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- ===== このサイトについて ===== -->
    <section class="wrap sec">
      <SectionHead id="about" kicker="このサイトについて" title="安心して使っていただくために" />
      <div class="steps reveal">
        {HUB.TRUST.map((x, i) => (
          <div class="step">
            <div class="step-n">{String(i + 1).padStart(2, "0")}</div>
            <div class="step-t">{x.t}</div>
            <p class="step-d">{x.d}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== よくある質問 ===== -->
    <section class="wrap sec sec-tight">
      <SectionHead id="faq" kicker="はじめての方へ" title="よくある質問" />
      <Faq items={HUB.FAQ} />
    </section>

    <Corp desc="Webサイトの制作から、業務に合わせた専用ツールの開発までお受けしています。ここにあるツールと同じように、開いてすぐに使えるものを会社やチームに合わせてつくります。「社内のこの作業、Webで片づけられないかな」という段階からでも、ご相談いただけます。" />
  </main>

  <Footer cols={FOOT} />
</Base>

<script>
  import "../scripts/hub.js";
</script>
