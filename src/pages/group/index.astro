---
/* グループ分けメーカー：人数を決めて押すだけで、均等なグループに分ける。動きは src/scripts/tools/group.js */
import ToolPage from "../../layouts/ToolPage.astro";
import Icon from "../../components/Icon.astro";
import Stepper from "../../components/tools/Stepper.astro";
import NamesField from "../../components/tools/NamesField.astro";

const FAQ = [
  { q: "入れた名前はどこかに送られますか？", a: "送られません。グループ分けは、すべてお使いのブラウザの中で行います。名前が運営者のサーバーに届くことはなく、保存もしません。" },
  { q: "人数が割り切れないときは？", a: "「人数をなるべく均等にする」がオンなら、グループの人数の差が1人以内になるように分けます。オフにすると、1グループの人数ずつ区切り、余った人を最後のグループにまとめます。" },
  { q: "部署や男女がばらけるように分けられますか？", a: "できます。名前のあとに「,」かタブで部署を書くと（例：田中,営業）、「部署などをばらけさせる」が選べるようになります。部署の代わりに「男」「女」や学年を書けば、それがばらけるように分けます。Excelの2列をそのまま貼り付けても読み取れます。" },
  { q: "「この2人は別のグループに」はできますか？", a: "できます。「条件をつける」を開き、別のグループにしたい2人、または同じグループにしたい2人を、1行に1組ずつ書いてください（例：田中 佐藤）。できるかぎり守るように分けます。人数の都合でどうしても守れないときは、そのことをお知らせします。" },
  { q: "前回とちがう組み合わせにできますか？", a: "できます。前回の結果はどこにも残らないので、前回同じグループだった人どうしを「条件をつける」の「別のグループにしたい組み合わせ」に書いてください。1行に前回のグループの全員を並べて書くと（例：田中 佐藤 鈴木）、その全員ができるかぎり別々のグループに入り、前回と組み合わせが重なりにくくなります。" },
  { q: "結果をExcelで使いたいです", a: "「CSVで保存」を押すと、グループと名前の一覧をCSVファイルで保存できます。Excelでそのまま開けます。" },
  { q: "リーダーが決まっていて、残りだけランダムにしたいです", a: "リーダーにする人の名前の前に「★」を付けてください（例：★田中）。★の人を1グループに1人ずつ先に分けてから、残りの人をランダムに入れます。グループディスカッションの面接官や、研修のファシリテーターを各グループに1人ずつ入れたいときに使えます。★の人がグループの数より多いときは、なるべく均等に分けます。" },
  { q: "リーダーはどうやって決まりますか？", a: "名前の前に★を付けた人がリーダーになります。★の人がいないグループでは、「リーダーを決める」をオンにすると、そのグループの中からランダムに1人を選んで「リーダー」の印を付けます。" },
];

const SCENES = {
  intro: "グループ分けは、ランダムにするだけなら簡単でも、「部署がかたよらないように」「この2人は離して」と条件が増えるほど手作業がつらくなります。よくある条件は、名前の書き方と「条件をつける」で指定できます。",
  groups: [
    {
      h: "社内研修・ワークショップ",
      items: [
        ["新人研修のグループワークで、同じ配属先の人が固まらないようにしたい", "「田中,営業」のように部署を書くと、部署がばらけるように分けます。Excelの2列をそのまま貼っても読み取れます。"],
        ["研修のファシリテーターや先輩社員を、各グループに1人ずつ入れたい", "名前の前に「★」を付けた人を、1グループに1人ずつ先に配置してから、残りを分けます。"],
        ["グループディスカッションの選考で、回ごとに学生の組み合わせを変えたい", "押すたびに分け直せるので、新しい組み合わせをその場で出せます。"],
        ["全体研修の50人を、6人ずつの班に分けたい", "1グループの人数を6にすれば、グループの数は自動で決まり、人数の差は1人以内にそろいます。"],
      ],
    },
    {
      h: "学校・授業・部活",
      items: [
        ["授業の班分けで、男女がなるべく均等になるようにしたい", "「佐藤,男」「鈴木,女」のように書けば、男女を散らして分けられます。"],
        ["一緒にすると騒がしくなる2人を、別の班にしたい", "「別のグループにしたい組み合わせ」に書いておけば、できるかぎり別々にします。"],
        ["球技大会や体育のチーム決めを、くじ引きより早く済ませたい", "チームの数を決めて押すだけで決まります。結果は「画像で保存」で画像にして、そのまま見せられます。"],
      ],
    },
    {
      h: "懇親会・地域の活動",
      items: [
        ["懇親会で、テーブル対抗ゲームのチームを決めたい", "ランダムに混ざるので、ふだん一緒にならない人どうしも同じチームになります。"],
        ["町内会の清掃やボランティアで、作業の班を割り振りたい", "グループの名前を「1班・2班」にすれば、班ごとの名簿としてそのまま使えます。"],
        ["親子や夫婦など、一緒にいたい人は同じ班にしたい", "「同じグループにしたい組み合わせ」に書いておけば、2人がまとめて入ります。"],
        ["前回と同じ顔ぶれにならないようにしたい", "前回いっしょだった2人を「別のグループにしたい組み合わせ」に書くと、重なりにくくなります。"],
        ["班分けの結果を、Excelの名簿にまとめておきたい", "「CSVで保存」を押すと、グループと名前の一覧を、Excelで開けるファイルで保存できます。"],
      ],
    },
  ],
};
---
<ToolPage
  slug="group"
  title="研修・授業の班分けを均等にランダムで｜グループ分けメーカー｜insemble tools"
  description="社内研修のグループワーク、授業の班分け、ワークショップのチーム分けを、名前を入れるだけで均等に分ける無料ツールです。部署や男女をばらけさせる、リーダーを1班に1人ずつ入れる、2人を別の班にするなどの指定もできます。結果はコピー・画像・CSVで保存できます。"
  ogTitle="グループ分けメーカー｜研修・授業の班分けを、もう悩まない"
  h1="グループ分けメーカー｜研修・授業の班分けを均等にする無料ツール"
  lead={["誰と誰を組ませるか、", "もう悩まない", "。"]}
  sub="名前を入れて、グループの数を決めて押すだけで分けられます。部署をばらけさせたり、「この2人は別に」と指定したりもできます。"
  meta={[["check", "端末内で処理"], ["check", "名前は送信しません"]]}
  steps={[
    { t: "名前を入れる", d: "参加者を1行に1人ずつ入れます。「★田中」と書くとリーダーとして各グループに1人ずつ、「田中,営業」と書くと部署がばらけるように分けます。" },
    { t: "数を決めて押す", d: "グループの数か1グループの人数を決めて、「グループに分ける」を押します。何度でも分け直せます。" },
    { t: "結果を配る", d: "文字でコピーするほか、画像やCSV（Excelで開ける表のファイル）でも保存できます。用途に合わせて選んでください。" },
  ]}
  scenes={SCENES}
  faq={FAQ}
  about={[
    ["しくみ", "入れた名前を、指定したグループの数に、なるべく均等になるようランダムに割り振ります。条件があるときは、守れる組み合わせを探します。"],
    ["保存", "入れた名前と結果は、どこにも送らず、保存もしません。ページを閉じると消えます。"],
    ["人数", "500人まで入れられます。1グループの人数は100人までです。"],
  ]}
  relatedSub="班が決まったら、発表の順番はルーレットで決められます。懇親会の席決めには、席順メーカーが使えます。"
  corp="たとえば「過去の組み合わせを覚えておいて、毎回ちがうメンバーになるよう研修の班を決める」ような、専用ツールもつくれます。"
  updated="2026-10-05"
>
  <div class="tp-panel">
    <div class="tp-split">
      <form class="tp-in" id="grp-form" novalidate>
        <NamesField id="grp-names" hint="1行に1人（★でリーダー・,で部署）" placeholder="★田中&#10;★佐藤&#10;鈴木&#10;高橋&#10;山田&#10;伊藤" />
        <p class="grp-lead-note" id="grp-lead-note" role="status" hidden></p>
        <div class="sets">
          <div class="set">
            <span class="set-l">グループの数</span>
            <Stepper id="grp-groups" label="グループの数" value={2} max={500} />
          </div>
          <div class="set">
            <span class="set-l">1グループの人数</span>
            <Stepper id="grp-per" label="1グループの人数" value={4} max={100} />
          </div>
          <p class="set-sum" id="grp-sum" aria-live="polite"></p>
          <div class="set">
            <span class="set-l">グループの名前</span>
            <div class="pick" id="grp-label" role="group" aria-label="グループの名前">
              <button type="button" data-v="abc" aria-pressed="true">A・B・C</button>
              <button type="button" data-v="num" aria-pressed="false">1班・2班</button>
            </div>
          </div>
          <label class="chk"><input type="checkbox" id="grp-even" checked />人数をなるべく均等にする</label>
          <label class="chk"><input type="checkbox" id="grp-random" checked />ランダムに分ける<span class="fld-hint">外すと、入れた順に分けます</span></label>
          <label class="chk"><input type="checkbox" id="grp-leader" />リーダーを決める<span class="fld-hint">★の人がいないグループは、ランダムに選びます</span></label>
          <label class="chk" id="grp-spread-row" hidden><input type="checkbox" id="grp-spread" checked />部署などをばらけさせる<span class="fld-hint">「,」のあとに書いたもの</span></label>
        </div>
        <details class="more">
          <summary><Icon name="chevron" size={16} />条件をつける（任意）</summary>
          <div class="more-body">
            <label class="fld">
              <span class="fld-l">別のグループにしたい組み合わせ<span class="fld-hint">1行に1組</span></span>
              <textarea class="ta sm" id="grp-apart" rows="3" placeholder="田中 佐藤" spellcheck="false"></textarea>
            </label>
            <label class="fld">
              <span class="fld-l">同じグループにしたい組み合わせ<span class="fld-hint">1行に1組</span></span>
              <textarea class="ta sm" id="grp-together" rows="3" placeholder="鈴木 高橋" spellcheck="false"></textarea>
            </label>
          </div>
        </details>
        <button type="submit" class="btn btn-primary btn-lg btn-block"><Icon name="shuffle" size={18} />グループに分ける</button>
        <div class="msgs" id="grp-msgs"></div>
      </form>

      <div class="tp-out" id="grp-out">
        <div class="empty">
          <div class="re-ic"><Icon name="users" size={22} tool /></div>
          <p class="re-t">ここにグループが出ます</p>
          <p class="re-d">名前を入れて「グループに分ける」を押してください。</p>
        </div>
      </div>
    </div>
  </div>
</ToolPage>

<script>
  import "../../scripts/tools/group.js";
</script>

<style is:global>
  .set-sum{font-size:14px;font-weight:700;color:var(--primary-ink);padding:10px 0;border-bottom:1px solid var(--line)}
  .gp-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:var(--g-md) var(--g-md)}
  .gp{min-width:0}
  .gp-h{display:flex;align-items:baseline;justify-content:space-between;gap:8px;padding-bottom:8px;border-bottom:3px solid var(--hue)}
  .gp-h b{font-family:var(--font-display);font-weight:800;font-size:19px;color:var(--ink)}
  .gp-h span{font-size:13px;color:var(--muted)}
  .gp ol{list-style:none}
  .gp li{display:flex;align-items:center;gap:8px;min-height:44px;padding:8px 2px;border-bottom:1px solid var(--line);font-weight:700;font-size:16px;color:var(--ink);overflow-wrap:anywhere}
  .gp li::before{content:"";width:8px;height:8px;border-radius:99px;background:var(--hue);flex-shrink:0}
  .gp li small{margin-left:auto;font-size:12.5px;font-weight:500;color:var(--muted);white-space:nowrap}
  .grp-lead-note{font-size:14px;font-weight:700;color:var(--warn-ink);background:var(--warn-bg);border-radius:10px;padding:8px 12px;margin-top:-8px}
  .grp-lead-note[hidden]{display:none}
  .gp-lead{display:inline-flex;align-items:center;gap:3px;font-size:11.5px;font-weight:700;color:var(--warn-ink);background:var(--warn-bg);border-radius:99px;padding:1px 8px;white-space:nowrap}
</style>
