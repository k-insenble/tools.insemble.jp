---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path: string;             // 例 "/" や "/ogp/"
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;         // 絶対URL。未指定なら /og-image.png
  jsonLd?: unknown;
  noindex?: boolean;        // 404 など検索に載せないページ。canonical は出さない
}
// ?url= 付きのURLは canonical で本体（path）にまとめる。noindex と併用すると本体まで外れるおそれがあるため使わない
const { title, description, path, ogTitle, ogDescription, ogImage, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const image = ogImage ?? new URL("/og-image.png", Astro.site).href;
// 計測タグ（Google アナリティクス・Microsoft Clarity）。本番ビルドだけで読み込む（手元の開発では数えない）
// タグの中身を変えると、public/.htaccess の CSP のハッシュとずれる（Report-Only なので警告が出るだけ。直し方は README）
// Clarity の録画では、入れたURLとチェック結果を data-clarity-mask で伏せ字にしている（ogp/index.astro・index.astro）
const useTags = import.meta.env.PROD;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="insemble tools" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2e6a74" />
    <meta name="twitter:image" content={image} />
    <meta property="og:image:alt" content={ogTitle ?? title} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@800&display=swap" rel="stylesheet" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {useTags && <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-BE85334L8G"></script>}
    {useTags && <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      // チェックしたURL（#url= / ?url=）を Google に送らないよう、そこだけ外して送る（utm_ などの計測用の値は残す）
      var gaClean = function (u) { try { var x = new URL(u); x.hash = ''; x.searchParams.delete('url'); return x.href; } catch (e) { return ''; } };
      var gaOpt = { page_location: gaClean(location.href) };
      if (document.referrer) gaOpt.page_referrer = gaClean(document.referrer);
      gtag('config', 'G-BE85334L8G', gaOpt);
    </script>}
    {useTags && <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "yqb8racgfy");
    </script>}
  </head>
  <body>
    <div class="app-root"><slot /></div>
  </body>
</html>
