---
import Icon from "./Icon.astro";

interface Props {
  desc: string;
  title?: string[];  // 見出し（1要素＝1行）。ツールページでは「会社やチームの専用に」の一言にする
  cta?: string;      // 相談ボタンの文言
}
const { desc, title = ["このサイトのツールをつくっている、", "札幌のWeb制作会社です。"], cta = "制作のご相談" } = Astro.props;
---
<section class="corp" id="corp">
  <div class="wrap corp-in">
    <div class="corp-main">
      <div class="corp-k">運営会社について</div>
      <h2 class="corp-t">{title.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2>
      <p class="corp-name"><span class="corp-logo">insemble</span><span class="corp-kana">インセンブル</span><span class="corp-sep"></span><span class="corp-loc">北海道 札幌市</span></p>
      <p class="corp-d">{desc}</p>
    </div>
    <div class="corp-a">
      <a class="btn btn-primary" href="https://www.insemble.co.jp/contact" target="_blank" rel="noopener">{cta}<Icon name="arrow" size={15} /></a>
      <a class="btn btn-ghost" href="https://www.insemble.co.jp/" target="_blank" rel="noopener">会社サイトを見る</a>
    </div>
  </div>
</section>
