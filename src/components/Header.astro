---
import Icon from "./Icon.astro";

interface Props {
  nav: [href: string, label: string][];
}
const { nav } = Astro.props;
---
<!-- スクロールで .on が付く（src/scripts/site.js） -->
<header class="hdr">
  <div class="wrap hdr-in">
    <a class="logo" href="/">
      <span class="logo-mark"><Icon name="bolt" size={17} /></span>
      <span class="logo-tx">insemble<span class="logo-sub">tools</span></span>
    </a>
    <nav class="nav">{nav.map(([href, label]) => <a href={href}>{label}</a>)}</nav>
    <a class="btn btn-ghost hdr-cta" href="https://www.insemble.co.jp/contact" target="_blank" rel="noopener">制作のご相談</a>
  </div>
</header>
