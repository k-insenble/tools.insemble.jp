---
import Icon from "./Icon.astro";

interface Props {
  cols: { h: string; items: [label: string, href: string][] }[];
}
const { cols } = Astro.props;
const ext = (href: string) => href.startsWith("http");
---
<footer class="ftr">
  <div class="wrap ftr-in">
    <div class="ftr-brand">
      <a class="logo" href="/">
        <span class="logo-mark"><Icon name="bolt" size={17} /></span>
        <span class="logo-tx">insemble<span class="logo-sub">tools</span></span>
      </a>
      <p class="ftr-tag">Web制作のこまごまを、ぜんぶここで。<br />無料・登録不要・広告なし。</p>
      <p class="ftr-note">当サイトはリンクフリーです。</p>
    </div>
    {cols.map((c) => (
      <div class="ftr-col">
        <div class="ftr-h">{c.h}</div>
        {c.items.map(([label, href]) => (
          <a href={href} target={ext(href) ? "_blank" : undefined} rel={ext(href) ? "noopener" : undefined}>{label}</a>
        ))}
      </div>
    ))}
  </div>
  <div class="wrap ftr-bottom">
    <span>© 2026 insemble</span>
    <a class="ftr-corp" href="https://www.insemble.co.jp/" target="_blank" rel="noopener">
      <span class="ftr-corp-k">運営</span>
      <span class="ftr-corp-name">insemble<span class="ftr-corp-kana">インセンブル</span></span>
      <Icon name="arrow" size={14} />
    </a>
  </div>
</footer>
